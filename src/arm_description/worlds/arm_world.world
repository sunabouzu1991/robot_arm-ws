<?xml version="1.0" ?>
<sdf version="1.6">
	<world name="default">

		<!-- Включение солнца и земли -->
		<include>
			<uri>model://sun</uri>
		</include>
		<include>
			<uri>model://ground_plane</uri>
		</include>

		<!-- Настройки физического движка ODE -->
		<physics type="ode">
			<max_step_size>0.001</max_step_size>
			<real_time_factor>1.0</real_time_factor>
			<real_time_update_rate>1000</real_time_update_rate>
			<ode>
				<solver>
					<type>quick</type>
					<iters>150</iters> <!-- Увеличено с 50 до 150 для точной сходимости -->
					<sor>1.3</sor>
				</solver>
				<constraints>
					<cfm>0.00001</cfm> <!-- Смягчение связей для устранения микровибраций -->
					<erp>0.2</erp>     <!-- Коррекция ошибок положения -->
					<contact_max_correcting_vel>100.0</contact_max_correcting_vel>
					<contact_surface_layer>0.001</contact_surface_layer>
				</constraints>
			</ode>
		</physics>

		<!-- Публикация состояний модели и звеньев: /gazebo/model_states, /gazebo/link_states -->
		<plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
			<ros>
				<namespace>/</namespace>
				<remapping>model_states:=gazebo/model_states</remapping>
				<remapping>link_states:=gazebo/link_states</remapping>
			</ros>
			<update_rate>30.0</update_rate>
		</plugin>

	</world>
</sdf>