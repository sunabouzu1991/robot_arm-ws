<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

    <!-- Хардварные интерфейсы для Gazebo включаются только при use_gazebo:=true.
         Иначе (MoveIt/mock) интерфейсы объявляет arm.ros2_control.xacro — дублировать нельзя. -->
    <xacro:arg name="use_gazebo" default="false"/>

    <!-- Компактный прототип с нейтральной высотой TCP около 0.50 м. -->
    <xacro:property name="base_width" value="0.16"/>
    <xacro:property name="base_height" value="0.10"/>
    <xacro:property name="upper_arm_length" value="0.12"/>
    <xacro:property name="forearm_length" value="0.13"/>
    <xacro:property name="wrist_mount_length" value="0.08"/>
    <xacro:property name="wrist_roll_length" value="0.025"/>
    <xacro:property name="wrist_pitch_length" value="0.02"/>
    <xacro:property name="tool_flange_length" value="0.02"/>
    <xacro:property name="tcp_offset" value="0.025"/>

    <!-- Проектный mass budget модели равен 4.15 кг с учетом основания. -->
    <xacro:property name="base_mass" value="1.2"/>
    <xacro:property name="upper_arm_mass" value="0.9"/>
    <xacro:property name="forearm_mass" value="0.8"/>
    <xacro:property name="wrist_mount_mass" value="0.45"/>
    <xacro:property name="wrist_roll_mass" value="0.35"/>
    <xacro:property name="wrist_pitch_mass" value="0.25"/>
    <xacro:property name="tool_flange_mass" value="0.2"/>

    <!-- Цвета для RViz -->
    <material name="gray"><color rgba="0.3 0.3 0.3 1.0"/></material>
    <material name="blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
    <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    <material name="green"><color rgba="0.1 0.7 0.3 1.0"/></material>
    <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>

    <!-- МИР -->
    <link name="world"/>

    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- BASE LINK -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <geometry><box size="${base_width} ${base_width} ${base_height}"/></geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <geometry><box size="${base_width} ${base_width} ${base_height}"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <mass value="${base_mass}"/>
            <inertia
                ixx="${base_mass * (base_width ** 2 + base_height ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${base_mass * (base_width ** 2 + base_height ** 2) / 12}"
                iyz="0.0"
                izz="${base_mass * (2 * base_width ** 2) / 12}"/>
        </inertial>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- JOINT 1, вращение основания вокруг Z -->
    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 1, верхнее плечо -->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 ${upper_arm_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${upper_arm_length}" radius="0.035"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${upper_arm_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${upper_arm_length}" radius="0.035"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${upper_arm_length / 2}" rpy="0 0 0"/>
            <mass value="${upper_arm_mass}"/>
            <inertia
                ixx="${upper_arm_mass * (3 * 0.035 ** 2 + upper_arm_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${upper_arm_mass * (3 * 0.035 ** 2 + upper_arm_length ** 2) / 12}"
                iyz="0.0"
                izz="${upper_arm_mass * 0.035 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_1">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- JOINT 2, наклон плеча вокруг Y -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 ${upper_arm_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="150.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 2, предплечье -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 ${forearm_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${forearm_length}" radius="0.03"/></geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${forearm_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${forearm_length}" radius="0.03"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${forearm_length / 2}" rpy="0 0 0"/>
            <mass value="${forearm_mass}"/>
            <inertia
                ixx="${forearm_mass * (3 * 0.03 ** 2 + forearm_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${forearm_mass * (3 * 0.03 ** 2 + forearm_length ** 2) / 12}"
                iyz="0.0"
                izz="${forearm_mass * 0.03 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_2">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- JOINT 3, наклон локтя вокруг Y -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6180" upper="2.6180" effort="100.0" velocity="2.5"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 3, основание запястья -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 ${wrist_mount_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_mount_length}" radius="0.027"/></geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${wrist_mount_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_mount_length}" radius="0.027"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${wrist_mount_length / 2}" rpy="0 0 0"/>
            <mass value="${wrist_mount_mass}"/>
            <inertia
                ixx="${wrist_mount_mass * (3 * 0.027 ** 2 + wrist_mount_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wrist_mount_mass * (3 * 0.027 ** 2 + wrist_mount_length ** 2) / 12}"
                iyz="0.0"
                izz="${wrist_mount_mass * 0.027 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_3">
        <material>Gazebo/Green</material>
    </gazebo>

    <!-- JOINT 4, вращение запястья вокруг Z -->
    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 ${wrist_mount_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 4, корпус запястья -->
    <link name="link_4">
        <visual>
            <origin xyz="0 0 ${wrist_roll_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_roll_length}" radius="0.04"/></geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${wrist_roll_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_roll_length}" radius="0.04"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${wrist_roll_length / 2}" rpy="0 0 0"/>
            <mass value="${wrist_roll_mass}"/>
            <inertia
                ixx="${wrist_roll_mass * (3 * 0.04 ** 2 + wrist_roll_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wrist_roll_mass * (3 * 0.04 ** 2 + wrist_roll_length ** 2) / 12}"
                iyz="0.0"
                izz="${wrist_roll_mass * 0.04 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_4">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- JOINT 5, наклон запястья вокруг Y -->
    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 ${wrist_roll_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="50.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 5, опора фланца -->
    <link name="link_5">
        <visual>
            <origin xyz="0 0 ${wrist_pitch_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_pitch_length}" radius="0.035"/></geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${wrist_pitch_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${wrist_pitch_length}" radius="0.035"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${wrist_pitch_length / 2}" rpy="0 0 0"/>
            <mass value="${wrist_pitch_mass}"/>
            <inertia
                ixx="${wrist_pitch_mass * (3 * 0.035 ** 2 + wrist_pitch_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wrist_pitch_mass * (3 * 0.035 ** 2 + wrist_pitch_length ** 2) / 12}"
                iyz="0.0"
                izz="${wrist_pitch_mass * 0.035 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_5">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- JOINT 6, вращение фланца вокруг Z -->
    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0 0 ${wrist_pitch_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="30.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 6, фланец инструмента -->
    <link name="link_6">
        <visual>
            <origin xyz="0 0 ${tool_flange_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${tool_flange_length}" radius="0.03"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${tool_flange_length / 2}" rpy="0 0 0"/>
            <geometry><cylinder length="${tool_flange_length}" radius="0.03"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${tool_flange_length / 2}" rpy="0 0 0"/>
            <mass value="${tool_flange_mass}"/>
            <inertia
                ixx="${tool_flange_mass * (3 * 0.03 ** 2 + tool_flange_length ** 2) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${tool_flange_mass * (3 * 0.03 ** 2 + tool_flange_length ** 2) / 12}"
                iyz="0.0"
                izz="${tool_flange_mass * 0.03 ** 2 / 2}"/>
        </inertial>
    </link>

    <gazebo reference="link_6">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- ПЛАГИН GAZEBO ROS2 CONTROL -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find arm_description)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ИНТЕРФЕЙСЫ GAZEBO ROS2 CONTROL (включаются аргументом use_gazebo:=true) -->
    <xacro:if value="$(arg use_gazebo)">
        <ros2_control name="GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="joint_1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_4">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_5">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_6">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </xacro:if>

    <!-- TOOL CENTER POINT (TCP) -->
    <link name="tcp"/>

    <joint name="joint_tcp" type="fixed">
        <parent link="link_6"/>
        <child link="tcp"/>
        <origin xyz="0 0 ${tcp_offset}" rpy="0 0 0"/>
    </joint>

</robot>
