<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

    <!-- Хардварные интерфейсы для Gazebo включаются только при use_gazebo:=true.
         Иначе (MoveIt/mock) интерфейсы объявляет arm.ros2_control.xacro — дублировать нельзя. -->
    <xacro:arg name="use_gazebo" default="false"/>

    <!-- Цвета для RViz -->
    <material name="gray"><color rgba="0.3 0.3 0.3 1.0"/></material>
    <material name="blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
    <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    <material name="green"><color rgba="0.1 0.7 0.3 1.0"/></material>
    <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>

    <!-- МИР -->
    <link name="world"/>

    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- BASE LINK -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry><box size="0.2 0.2 0.2"/></geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry><box size="0.2 0.2 0.2"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <mass value="2.0"/>
            <inertia ixx="0.0133" ixy="0.0" ixz="0.0" iyy="0.0133" iyz="0.0" izz="0.0133"/>
        </inertial>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- JOINT 1: BASE YAW (ось Z), 0.20 -> 0.45 м -->
    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 1 (плечо, 0.25 м) -->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry><cylinder length="0.25" radius="0.06"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry><cylinder length="0.25" radius="0.06"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <mass value="1.8"/>
            <inertia ixx="0.0110" ixy="0.0" ixz="0.0" iyy="0.0110" iyz="0.0" izz="0.00324"/>
        </inertial>
    </link>

    <gazebo reference="link_1">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- JOINT 2: SHOULDER PITCH (ось Y), 0.45 -> 0.75 м -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="150.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 2 (верхнее звено, 0.30 м) -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder length="0.30" radius="0.05"/></geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry><cylinder length="0.30" radius="0.05"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <mass value="1.4"/>
            <inertia ixx="0.011375" ixy="0.0" ixz="0.0" iyy="0.011375" iyz="0.0" izz="0.00175"/>
        </inertial>
    </link>

    <gazebo reference="link_2">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- JOINT 3: ELBOW PITCH (ось Y), 0.75 -> 0.95 м -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.30" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6180" upper="2.6180" effort="100.0" velocity="2.5"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- LINK 3 (предплечье, 0.20 м) -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
            <geometry><cylinder length="0.20" radius="0.045"/></geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
            <geometry><cylinder length="0.20" radius="0.045"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
            <mass value="0.9"/>
            <inertia ixx="0.003456" ixy="0.0" ixz="0.0" iyy="0.003456" iyz="0.0" izz="0.000911"/>
        </inertial>
    </link>

    <gazebo reference="link_3">
        <material>Gazebo/Green</material>
    </gazebo>

    <!-- JOINT 4: WRIST ROLL (ось Z) -->
    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 0.20" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 4 (корпус кисти, 0.05 м) -->
    <link name="link_4">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.055"/></geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.055"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.4"/>
            <inertia ixx="0.000386" ixy="0.0" ixz="0.0" iyy="0.000386" iyz="0.0" izz="0.000605"/>
        </inertial>
    </link>

    <gazebo reference="link_4">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- JOINT 5: WRIST PITCH (ось Y) -->
    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="50.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 5 (качалка кисти, 0.05 м) -->
    <link name="link_5">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.05"/></geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.05"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.3"/>
            <inertia ixx="0.00025" ixy="0.0" ixz="0.0" iyy="0.00025" iyz="0.0" izz="0.000375"/>
        </inertial>
    </link>

    <gazebo reference="link_5">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- JOINT 6: TOOL ROLL (ось Z) -->
    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="30.0" velocity="3.0"/>
        <dynamics damping="0.3" friction="0.05"/>
    </joint>

    <!-- LINK 6 (фланец инструмента, 0.05 м) -->
    <link name="link_6">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.045"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry><cylinder length="0.05" radius="0.045"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.000143" ixy="0.0" ixz="0.0" iyy="0.000143" iyz="0.0" izz="0.000203"/>
        </inertial>
    </link>

    <gazebo reference="link_6">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- ПЛАГИН GAZEBO ROS2 CONTROL -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find arm_description)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ИНТЕРФЕЙСЫ GAZEBO ROS2 CONTROL (включаются аргументом use_gazebo:=true) -->
    <xacro:if value="$(arg use_gazebo)">
        <ros2_control name="GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="joint_1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_4">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_5">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_6">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </xacro:if>

    <!-- TOOL CENTER POINT (TCP) -->
    <link name="tcp"/>

    <joint name="joint_tcp" type="fixed">
        <parent link="link_6"/>
        <child link="tcp"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

</robot>
